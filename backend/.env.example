# Database
DATABASE_URL="postgresql://user:password@localhost:5433/financing_panel?schema=public"

# JWT
JWT_SECRET="your-super-secret-jwt-key-min-32-chars-change-in-production"
JWT_EXPIRES_IN="8h"
JWT_REFRESH_SECRET="your-refresh-secret-key-min-32-chars-change-in-production"
JWT_REFRESH_EXPIRES_IN="7d"

# Server
PORT=4000
NODE_ENV="development"
FRONTEND_URL="http://localhost:3000"

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Encryption (for sensitive data at rest)
ENCRYPTION_KEY="your-32-char-encryption-key-here!!"

# Logging
LOG_LEVEL="info"

# Partner API Configuration (configure via admin panel or database)
# Example for a bank partner:
# PARTNER_BANK_NAME="Banco Exemplo"
# PARTNER_BASE_URL="https://api.bancoexemplo.com.br"
# PARTNER_AUTH_TYPE="oauth2"
# PARTNER_CLIENT_ID="your-client-id"
# PARTNER_CLIENT_SECRET="your-client-secret"
# PARTNER_IS_TEST_ENV="true"
# PARTNER_REQUIRED_FIELDS='["fullName", "cpf", "birthDate", "monthlyIncome", "propertyValue", "downPayment"]'