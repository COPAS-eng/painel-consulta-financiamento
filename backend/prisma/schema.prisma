generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  BROKER
  VIEWER
}

enum UserStatus {
  ACTIVE
  INACTIVE
  PENDING
}

enum ClientStatus {
  ACTIVE
  INACTIVE
  ARCHIVED
}

enum ConsultationStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  UNAVAILABLE
  EXPIRED
}

enum ConsentStatus {
  GIVEN
  REVOKED
  EXPIRED
}

model User {
  id           String     @id @default(cuid())
  email        String     @unique
  passwordHash String
  fullName     String
  role         UserRole   @default(BROKER)
  status       UserStatus @default(PENDING)
  lastLoginAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  clients      Client[]
  consultations Consultation[]
  auditLogs    AuditLog[]

  @@map("users")
}

model Client {
  id            String        @id @default(cuid())
  fullName      String
  cpf           String        @unique
  rg            String?
  birthDate     DateTime
  email         String?
  phone         String?
  monthlyIncome Decimal?      @db.Decimal(12, 2)
  profession    String?
  maritalStatus String?
  address       Json?
  status        ClientStatus  @default(ACTIVE)
  notes         String?
  createdById   String
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  createdBy     User          @relation(fields: [createdById], references: [id])
  consultations Consultation[]
  consents      Consent[]

  @@index([cpf])
  @@index([fullName])
  @@map("clients")
}

model Consent {
  id              String        @id @default(cuid())
  clientId        String
  purpose         String
  partnerName     String
  partnerEndpoint String
  dataFields      String[]
  ipAddress       String?
  userAgent       String?
  status          ConsentStatus @default(GIVEN)
  givenAt         DateTime      @default(now())
  revokedAt       DateTime?
  expiresAt       DateTime?

  client          Client        @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@map("consents")
}

model Consultation {
  id              String            @id @default(cuid())
  clientId        String
  requestedById   String
  partnerName     String
  partnerEndpoint String
  requestPayload  Json
  responsePayload Json?
  status          ConsultationStatus @default(PENDING)
  externalId      String?
  errorCode       String?
  errorMessage    String?
  startedAt       DateTime          @default(now())
  completedAt     DateTime?
  expiresAt       DateTime?

  client         Client            @relation(fields: [clientId], references: [id], onDelete: Cascade)
  requestedBy    User              @relation(fields: [requestedById], references: [id])

  @@index([clientId])
  @@index([requestedById])
  @@index([status])
  @@index([startedAt])
  @@map("consultations")
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String
  entityType  String
  entityId    String?
  oldData     Json?
  newData     Json?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime @default(now())

  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}

model PartnerConfig {
  id            String   @id @default(cuid())
  name          String   @unique
  displayName   String
  baseUrl       String
  authType      String
  credentials   Json
  isActive      Boolean  @default(false)
  isTestEnv     Boolean  @default(true)
  rateLimit     Int      @default(60)
  requiredFields String[]
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("partner_configs")
}

model SystemConfig {
  id        String   @id @default(cuid())
  key       String   @unique
  value     Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("system_configs")
}